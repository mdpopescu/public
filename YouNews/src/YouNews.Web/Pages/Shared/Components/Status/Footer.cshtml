@model StatusView
@if (Model.LastRunText is not null || Model.Waiting.Count > 0 || Model.QueueText is not null)
{
    <footer class="status">
        @if (Model.LastRunText is not null)
        {
            <p>@Model.LastRunText</p>
        }
        @if (Model.LastRunProblem is not null)
        {
            <p class="status-problem">@Model.LastRunProblem</p>
        }
        @if (Model.Waiting.Count > 0)
        {
            <details>
                <summary>Waiting to retry (@Model.Waiting.Count)</summary>
                <ul>
                    @foreach (var video in Model.Waiting)
                    {
                        <li>
                            <a href="@video.Url" target="_blank" rel="noopener noreferrer">@video.Title</a>
                            <span class="muted">(@video.Detail)</span>: @video.Reason
                        </li>
                    }
                </ul>
            </details>
        }
        @if (Model.QueueText is not null)
        {
            <details>
                <summary>@Model.QueueText</summary>
                <ul>
                    @foreach (var video in Model.Queue)
                    {
                        <li>
                            <a href="@video.Url" target="_blank" rel="noopener noreferrer">@video.Title</a>
                            @if (video.Detail.Length > 0)
                            {
                                <span class="muted">(@video.Detail)</span>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
    </footer>
}